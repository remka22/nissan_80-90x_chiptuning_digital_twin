Name     ECU_FM18W08;
Partno   00;
Date     25/08/2026;
Revision 01;
Designer J30_Remka22;
Company  ;
Assembly ;
Location ;
Device   g16v8;

/* ============================================================================
   ЛОГИКА GAL16V8B ДЛЯ FM18W08 (FRAM НА МЕСТЕ ROM)

   Назначение: генерирует сигнал /WE для FM18W08 из сигналов процессора HD6303

   Схема подключения:
   - Входы: R/W (пин 2), E (пин 3), A15 (пин 4) от разъёма ЭБУ
   - Выход: /WE (пин 19) → FM18W08 пин 27

   Логика записи:
   /WE = LOW  когда процессор ПИШЕТ (R/W=0) И такт активен (E=1)
   /WE = HIGH во всех остальных случаях (чтение или такт неактивен)

   Это позволяет процессору записывать в FM18W08 через загрузчик в прошивке.
   ============================================================================ */

/* Входы */
PIN 1  = NC1;           /* не используется */
PIN 2  = RW;            /* R/W от CPU (1=read, 0=write) */
PIN 3  = E;             /* Enable (такт шины CPU, активный высокий) */
PIN 4  = A15;           /* старший адрес (резерв для расширения) */
PIN 5  = NC5;           /* не используется */
PIN 6  = NC6;           /* не используется */
PIN 7  = NC7;           /* не используется */
PIN 8  = NC8;           /* не используется */
PIN 9  = NC9;           /* не используется */
PIN 11 = OE_GAL;        /* output enable GAL (на GND = всегда активен) */

/* Выходы */
PIN 12 = NC12;          /* не используется */
PIN 13 = NC13;          /* не используется */
PIN 14 = NC14;          /* не используется */
PIN 15 = NC15;          /* не используется */
PIN 16 = NC16;          /* не используется */
PIN 17 = NC17;          /* не используется */
PIN 18 = NC18;          /* не используется */
PIN 19 = WE_N;          /* /WE для FM18W08 (активный низкий) */

/* ============================================================================
   ЛОГИКА
   ============================================================================ */

/* /WE активен (LOW), когда:
   - процессор пишет (R/W = 0)
   - И такт активен (E = 1)

   В булевой логике:
   /WE = NOT (NOT RW AND E)
       = RW OR NOT E

   То есть /WE=0 только когда RW=0 И E=1
*/

WE_N = RW # !E;

/* Альтернативная запись (эквивалентная):
   WE_N = !((!RW) & E);

   Проверка таблицы истинности:
   RW | E | /WE
   ---|---|----
    0 | 0 |  1   (запись, но такт неактивен -> не пишем)
    0 | 1 |  0   (запись И такт активен -> ПИШЕМ)
    1 | 0 |  1   (чтение -> не пишем)
    1 | 1 |  1   (чтение -> не пишем)
*/

/* ============================================================================
   ПРИМЕЧАНИЯ

   1. A15 сейчас не используется, оставлен для будущего расширения
      (например, переключение банков памяти >32КБ)

   2. OE_GAL (пин 11) должен быть соединён с GND, чтобы выходы GAL были
      всегда активны

   3. Все неиспользуемые входы можно оставить висеть в воздухе (NC),
      GAL имеет внутренние подтяжки

   4. После компиляции получится .JED файл для программатора (TL866II+, T48)
   ============================================================================ */
