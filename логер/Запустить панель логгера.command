#!/bin/bash
# Двойной клик по этому файлу в Finder — поднимает панель и открывает её в браузере.
# Пока это окно Терминала открыто — панель работает. Закрыл окно (или Ctrl+C) — панель остановилась.
#
# ЕДИНАЯ панель: логгер, датчики, карты онлайн и обучение — всё на одной странице.
# Прежние отдельные панели (тюнинга / беспроводная / логгера 31.07) оставлены в папке,
# но запускать их незачем: они отстали по правкам и расходились между собой.
cd "/Users/remka22/Documents/ЭБУ Максима/1994_Nissan_Maxima_J30_RUS/логер" || exit 1

PANEL="логгер_j30.py"
PORT=8009

echo "================================================"
echo "  ПАНЕЛЬ ЛОГГЕРА ЭБУ"
echo "  Откроется: http://localhost:$PORT"
echo "  НЕ закрывай это окно, пока пользуешься панелью."
echo "  Остановить: закрой окно или нажми Ctrl+C."
echo "================================================"

# ЭТО ПЕРЕЗАПУСК, А НЕ ВТОРОЙ ЗАПУСК. Без этого второй экземпляр не поднимался вообще:
# порт 8009 уже занят, python падал с ошибкой, а окно закрывалось быстрее, чем её видно.
# Гасим ТОЛЬКО свою панель и только по имени файла — чужие python-процессы не трогаем.
if pgrep -f "$PANEL" > /dev/null; then
  echo "Панель уже запущена — останавливаю старую..."
  pkill -f "$PANEL"
  # ждём, пока освободится порт (до 5 с), иначе новая упрётся в занятый адрес
  for _ in $(seq 1 25); do
    pgrep -f "$PANEL" > /dev/null || break
    sleep 0.2
  done
  sleep 0.5
  echo "Старая остановлена."
fi

( sleep 2; open "http://localhost:$PORT" ) &
python3 "$PANEL" --http "$PORT"
